   "id": "c541ebb4",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_anomaly_scores(generator, discriminator, dataloader, device):\n",
    "    \"\"\"计算异常分数\"\"\"\n",
    "    generator.eval()\n",
    "    discriminator.eval()\n",
    "    \n",
    "    anomaly_scores = []\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for real_data in dataloader:\n",
    "            real_data = real_data.to(device).float()\n",
    "            \n",
    "            # 生成假数据\n",
    "            noise = torch.randn(real_data.shape[0], real_data.shape[1], real_data.shape[2]).to(device)\n",
    "            fake_data = generator(noise)\n",
    "            \n",
    "            # 计算重构误差（MSE）\n",
    "            reconstruction_error = torch.mean((real_data - fake_data) ** 2, dim=(1, 2))\n",
    "            \n",
    "            anomaly_scores.extend(reconstruction_error.cpu().numpy())\n",
    "    \n",
    "    return np.array(anomaly_scores)\n",
    "\n",
    "# 计算正常数据的异常分数\n",
    "normal_scores = compute_anomaly_scores(generator, discriminator, test_dl, device)\n",
    "\n",
    "# 计算攻击数据的异常分数\n",
    "attack_scores = compute_anomaly_scores(generator, discriminator, attack_dl, device)\n",
    "\n",
    "print(f\"正常数据异常分数范围: [{normal_scores.min():.4f}, {normal_scores.max():.4f}]\")\n",
    "print(f\"攻击数据异常分数范围: [{attack_scores.min():.4f}, {attack_scores.max():.4f}]\")"
   ]
  },
