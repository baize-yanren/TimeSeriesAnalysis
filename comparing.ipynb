     ]
    }
   ],
   "source": [
    "# 创建滑动窗口数据集\n",
    "dataset = WindowDataset(df_scaled, window_size=window_size, window_slide=window_stride)\n",
    "print(f\"数据集窗口数量: {len(dataset)}\")\n",
    "print(f\"每个窗口形状: {dataset[0].shape}\")\n",
    "\n",
    "# 划分训练集和测试集 (80-20)\n",
    "indices = torch.randperm(len(dataset))\n",
    "train_len = int(len(dataset) * 0.8)\n",
    "\n",
    "train_dataset = torch.utils.data.Subset(dataset, indices[:train_len].tolist())\n",
    "test_dataset = torch.utils.data.Subset(dataset, indices[train_len:].tolist())\n",
    "\n",
    "print(f\"训练集窗口数: {len(train_dataset)}\")\n",
    "print(f\"测试集窗口数: {len(test_dataset)}\")\n",
    "\n",
    "# 创建数据加载器\n",
    "train_dl = prepare_dataloader(train_dataset, batch_size=batch_size)\n",
    "test_dl = prepare_dataloader(test_dataset, batch_size=batch_size)\n",
    "\n",
    "# 创建潜在空间迭代器\n",
    "latent_space = LatentSpaceIterator(noise_shape=[batch_size, window_size, constants.LATENT_SPACE_DIM])\n",
    "\n",
    "print(f\"\\n训练数据加载器批次数: {len(train_dl)}\")\n",
    "print(f\"测试数据加载器批次数: {len(test_dl)}\")"
   ]
  },
  {
