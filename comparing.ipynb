   ],
   "source": [
    "# 训练参数\n",
    "batch_size = 32\n",
    "epochs = 8\n",
    "lr = 1e-4\n",
    "hidden_dim = 512\n",
    "window_size = constants.WINDOW_SIZE  # 默认 100\n",
    "window_stride = constants.WINDOW_STRIDE  # 默认 50\n",
    "random_seed = 42\n",
    "model_dir = 'models/madgan/checkpoints'\n",
    "\n",
    "# 设置随机种子\n",
    "set_seed(random_seed)\n",
    "\n",
    "# 创建模型保存目录\n",
    "os.makedirs(model_dir, exist_ok=True)\n",
    "\n",
    "print(f\"窗口大小: {window_size}\")\n",
    "print(f\"窗口步长: {window_stride}\")\n",
    "print(f\"特征数量: {df_scaled.shape[-1]}\")"
   ]
