    "# 移除非数值列\n",
    "df_train = df_normal.drop([' Timestamp', 'Normal/Attack'], axis=1)\n",
    "\n",
    "# 检查数据类型\n",
    "print(\"数据类型:\")\n",
    "print(df_train.dtypes.value_counts())\n",
    "\n",
    "# 检查缺失值\n",
    "print(f\"\\n缺失值数量: {df_train.isnull().sum().sum()}\")\n",
    "\n",
    "# 数据标准化（使用 MinMaxScaler）\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "scaler = MinMaxScaler(feature_range=(-1, 1))\n",
    "df_scaled = pd.DataFrame(scaler.fit_transform(df_train), columns=df_train.columns)\n",
    "\n",
    "print(f\"\\n标准化后数据形状: {df_scaled.shape}\")\n",
    "df_scaled.describe().transpose().head()"
