    "#### 配置训练参数"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "e4013f81",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "窗口大小: 256\n",
